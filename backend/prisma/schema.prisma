generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum City {
  dubai
  abu_dhabi
}

enum KycStatus {
  none
  pending
  verified
}

enum ListingStatus {
  active
  reserved
  sold
  removed
}

enum VerificationStatus {
  not_applicable
  unverified
  verified
}

enum VerificationType {
  none
  serial
  tag
  date_code
}

enum ItemCondition {
  new_with_tags
  like_new
  good
  fair
}

enum DeliveryOption {
  hand_off
  courier
  both
}

model User {
  id               String   @id @default(uuid())
  email            String   @unique
  phone            String?  @unique
  passwordHash     String   @map("password_hash")
  name             String
  profilePhotoUrl  String?  @map("profile_photo_url")
  city             City
  kycStatus        KycStatus @default(none) @map("kyc_status")
  kycProviderRefId String?  @map("kyc_provider_ref_id")
  payoutMethod     String?  @map("payout_method")
  ratingAvg        Float    @default(0) @map("rating_avg")
  ratingCount      Int      @default(0) @map("rating_count")
  createdAt        DateTime @default(now()) @map("created_at")

  listings       Listing[]
  offers         Offer[]
  buyerOrders    Order[]   @relation("BuyerOrders")
  sellerOrders   Order[]   @relation("SellerOrders")
  disputes       Dispute[]
  reviewsGiven   Review[]  @relation("ReviewsGiven")
  reviewsReceived Review[] @relation("ReviewsReceived")

  @@map("users")
}

model Brand {
  id                       String           @id @default(uuid())
  name                     String           @unique
  verificationType         VerificationType @map("verification_type")
  verificationInstructions String?          @map("verification_instructions")

  listings Listing[]

  @@map("brands")
}

model Category {
  id       String     @id @default(uuid())
  name     String
  parentId String?    @map("parent_id")
  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children Category[] @relation("CategoryTree")

  listings Listing[]

  @@map("categories")
}

model Listing {
  id                 String             @id @default(uuid())
  sellerId           String             @map("seller_id")
  title              String
  description        String?
  categoryId         String             @map("category_id")
  brandId            String?            @map("brand_id")
  size               String?
  condition          ItemCondition
  price              Float
  currency           String             @default("AED")
  status             ListingStatus      @default(active)
  verificationStatus VerificationStatus @default(not_applicable) @map("verification_status")
  verificationCode   String?            @map("verification_code")
  verificationPhotoUrl String?          @map("verification_photo_url")
  deliveryOptions    DeliveryOption     @map("delivery_options")
  createdAt          DateTime           @default(now()) @map("created_at")

  seller   User     @relation(fields: [sellerId], references: [id])
  category Category @relation(fields: [categoryId], references: [id])
  brand    Brand?   @relation(fields: [brandId], references: [id])
  photos   ListingPhoto[]
  offers   Offer[]
  orders   Order[]

  @@map("listings")
}

model ListingPhoto {
  id        String  @id @default(uuid())
  listingId String  @map("listing_id")
  url       String
  sortOrder Int     @default(0) @map("sort_order")

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@map("listing_photos")
}

enum OfferStatus {
  pending
  accepted
  rejected
  countered
  expired
}

model Offer {
  id        String      @id @default(uuid())
  listingId String      @map("listing_id")
  buyerId   String      @map("buyer_id")
  amount    Float
  status    OfferStatus @default(pending)
  expiresAt DateTime    @map("expires_at")
  createdAt DateTime    @default(now()) @map("created_at")

  listing Listing @relation(fields: [listingId], references: [id])
  buyer   User    @relation(fields: [buyerId], references: [id])
  order   Order?

  @@map("offers")
}

enum OrderStatus {
  pending_payment
  paid_escrow
  shipped
  delivered
  dispute_window
  completed
  disputed
  refunded
  cancelled
}

enum DeliveryMethod {
  hand_off
  courier
}

model Order {
  id                 String      @id @default(uuid())
  listingId          String      @map("listing_id")
  buyerId            String      @map("buyer_id")
  sellerId           String      @map("seller_id")
  offerId            String?     @unique @map("offer_id")
  finalPrice         Float       @map("final_price")
  deliveryMethod     DeliveryMethod @map("delivery_method")
  deliveryAddress    String?     @map("delivery_address")
  trackingNumber     String?     @map("tracking_number")
  status             OrderStatus @default(pending_payment)
  escrowPaymentRefId String?     @map("escrow_payment_ref_id")
  deliveredAt        DateTime?   @map("delivered_at")
  disputeDeadlineAt  DateTime?   @map("dispute_deadline_at")
  createdAt          DateTime    @default(now()) @map("created_at")

  listing  Listing  @relation(fields: [listingId], references: [id])
  buyer    User     @relation("BuyerOrders", fields: [buyerId], references: [id])
  seller   User     @relation("SellerOrders", fields: [sellerId], references: [id])
  offer    Offer?   @relation(fields: [offerId], references: [id])
  disputes Dispute[]
  reviews  Review[]

  @@map("orders")
}

enum DisputeReason {
  not_authentic
  not_as_described
  damaged
  not_received
  other
}

enum DisputeStatus {
  open
  awaiting_seller
  under_review
  resolved_refund
  resolved_release
}

model Dispute {
  id                       String        @id @default(uuid())
  orderId                  String        @map("order_id")
  openedBy                 String        @map("opened_by")
  reason                   DisputeReason
  description              String?
  status                   DisputeStatus @default(open)
  sellerResponseDeadlineAt DateTime?     @map("seller_response_deadline_at")
  resolutionNotes          String?       @map("resolution_notes")
  createdAt                DateTime      @default(now()) @map("created_at")

  order  Order @relation(fields: [orderId], references: [id])
  opener User  @relation(fields: [openedBy], references: [id])

  @@map("disputes")
}

model Review {
  id         String   @id @default(uuid())
  orderId    String   @map("order_id")
  reviewerId String   @map("reviewer_id")
  revieweeId String   @map("reviewee_id")
  rating     Int
  comment    String?
  createdAt  DateTime @default(now()) @map("created_at")

  order    Order @relation(fields: [orderId], references: [id])
  reviewer User  @relation("ReviewsGiven", fields: [reviewerId], references: [id])
  reviewee User  @relation("ReviewsReceived", fields: [revieweeId], references: [id])

  @@unique([orderId, reviewerId])
  @@map("reviews")
}

{
  "name": "@clasp/api",
  "version": "0.1.0",
  "private": true,
  "description": "Clasp control-plane API: workspaces, agents, MCP connections, runs.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --conditions=@clasp/source --env-file-if-exists=../../.env src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=../../.env dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --conditions=@clasp/source --env-file-if-exists=../../.env src/db/migrate.ts",
    "db:seed": "tsx --conditions=@clasp/source --env-file-if-exists=../../.env src/db/seed.ts"
  },
  "dependencies": {
    "@clasp/shared": "workspace:*",
    "@fastify/cors": "^11.4.1",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.8",
    "fastify-type-provider-zod": "^7.0.0",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "~11.14.0",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "pino-pretty": "^13.2.0"
  }
}

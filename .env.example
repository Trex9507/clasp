# Copy to .env and fill in. Never commit .env or real values.

# --- Platform (apps/api) ------------------------------------------------------
# Postgres for the platform API (docker compose up -d postgres).
DATABASE_URL=postgres://clasp:clasp@localhost:5432/clasp
# Anthropic API key. Without it the API runs on the in-memory FakeRuntime.
ANTHROPIC_API_KEY=

# --- Escrow prototype (parked) ------------------------------------------------
# Base Sepolia testnet
BASE_SEPOLIA_RPC_URL=
BASESCAN_API_KEY=
# Deployer private key: testnet only, never mainnet.
DEPLOYER_PRIVATE_KEY=
# USDC token address the escrow contract is deployed against.
USDC_ADDRESS=
# SQLite database for packages/escrow-mcp-server (defaults to db/escrow/clasp.db).
ESCROW_DATABASE_PATH=
# Base URL the provider agents call (the server is stdio-only for now; see docs/escrow-prototype.md).
MCP_BASE_URL=http://localhost:3100
# Model the provider agents use (defaults to claude-haiku-5-5).
CLASP_PROVIDER_MODEL=
# Platform wallet that collects fees (an address, not a private key).
PLATFORM_FEE_ADDRESS=
